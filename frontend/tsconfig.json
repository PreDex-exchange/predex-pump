{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@predex-pump/shared": ["../shared/src/index.ts"],
      "@predex-pump/shared/addresses": ["../shared/src/addresses.ts"],
      "@predex-pump/shared/domain": ["../shared/src/domain.ts"],
      "@predex-pump/shared/rest": ["../shared/src/rest.ts"],
      "@predex-pump/shared/tx": ["../shared/src/tx/index.ts"],
      "@predex-pump/shared/ws": ["../shared/src/ws.ts"],
      "@predex-pump/shared/*": ["../shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
