NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
# Comma-separated Arc wallets. Matching is case-insensitive.
NEXT_PUBLIC_AGENT_ADDRESSES=
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
# Optional Privy email wallet. Leave empty to keep MetaMask-only behavior.
# Both values are public identifiers from the Privy dashboard; never put the
# Privy app secret in the frontend.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
