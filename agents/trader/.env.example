# The trader is dry-run unless --send is passed or this is explicitly false.
PREDEX_DRY_RUN=true
PREDEX_API_URL=http://localhost:3001
PREDEX_RPC_URL=https://rpc.testnet.arc.network
# Optional in dry-run; in send mode it must match the signing key when set.
PREDEX_TRADER_ADDRESS=0x0000000000000000000000000000000000000000
# Runtime only. Never commit a real value.
PREDEX_PRIVATE_KEY=

PREDEX_QUOTE_SIZE_RAW=250000
PREDEX_TAKE_SIZE_RAW=250000
PREDEX_QUOTE_HALF_SPREAD_RAW=20000
PREDEX_TAKE_THRESHOLD_RAW=30000
PREDEX_REPRICE_THRESHOLD_RAW=10000
PREDEX_STALE_QUOTE_SECONDS=90
PREDEX_POLL_INTERVAL_MS=15000

# Hard safety caps. Actions are refused, never resized, when a cap would be crossed.
PREDEX_MAX_INVENTORY_PER_SIDE_RAW=2000000
PREDEX_MAX_NOTIONAL_PER_ORDER_RAW=500000
PREDEX_MAX_ORDERS_IN_FLIGHT=4
PREDEX_MAX_SESSION_SPEND_RAW=2000000
