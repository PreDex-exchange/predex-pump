DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=public
DATABASE_POOL_SIZE=32
DATABASE_POOL_TIMEOUT_SECONDS=10
# Disposable public read cache; never authoritative state.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=predex
MARKETS_CACHE_TTL_SECONDS=5
# Tests use an isolated schema and never truncate the development schema.
TEST_DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=contract_test
# Benchmarks accept only a perf_bench or perf_bench_* schema.
BENCH_DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=perf_bench
# Defaults to shared ARC.rpcUrls[0] when omitted.
ARC_RPC_URL=https://rpc.testnet.arc.network
# Defaults to shared ARC.webSocketRpcUrls when omitted. Set explicitly empty to
# disable subscriptions and use HTTP fallback polling.
ARC_WS_RPC_URL=wss://rpc.testnet.arc.network
# Conservative provider-safe range; this is a correctness control, not a tuning target.
INDEXER_BLOCK_CHUNK=2000
# Five-minute safety scan in WebSocket mode; HTTP-only fallback retains 10 seconds.
INDEXER_POLL_MS=300000
INDEXER_FALLBACK_POLL_MS=10000
INDEXER_CHUNK_DELAY_MS=200
INDEXER_STALL_MS=90000
# auto resumes gaps up to 100,000 blocks, then records a history gap and starts
# at the current head. Set head to force that jump now, or resume to never jump.
INDEXER_START_POLICY=auto
INDEXER_MAX_BACKFILL_BLOCKS=100000
INDEXER_WS_COALESCE_MS=250
INDEXER_WS_STALL_MS=15000
INDEXER_WS_HEARTBEAT_MS=5000
INDEXER_WS_OWNER_REFRESH_MS=30000
INDEXER_WS_RECONNECT_BASE_MS=1000
INDEXER_WS_RECONNECT_MAX_MS=30000
# REST and WebSocket share this listener. WebSocket path: /ws.
API_HOST=0.0.0.0
API_PORT=3001

# Explicitly enable the testnet operator's ADMIN_ROLE-gated CTFExchange token
# registration prerequisite. Mainnet role design is outside this release slice.
OPERATOR_REGISTER_TOKENS=false

# Browser origin and EIP-4361 audience. Account cookies are HttpOnly and scoped
# to this API; production HTTPS deployments should keep secure cookies enabled.
PREDEX_WEB_ORIGIN=http://localhost:3000
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_NONCE_TTL_SECONDS=300
ACCOUNT_SESSION_TTL_SECONDS=604800
ACCOUNT_COOKIE_SECURE=false

# Same-fact dedup. Leave OPENAI_API_KEY empty to use the deterministic local provider.
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=
DEDUP_TOP_K=5
DEDUP_TIMEOUT_MS=5000

# Truth x402 seller. Disabled keeps the Stage 1 endpoint unpaid for local development.
PREDEX_TRUTH_SELLER_MODE=disabled
# Public payment recipient only; the backend never needs a seller private key.
PREDEX_TRUTH_SELLER_ADDRESS=
# 100 raw USDC = $0.0001. Circle Gateway Nanopayments accepts down to 1 raw.
PREDEX_TRUTH_PRICE_RAW=100
PREDEX_GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
