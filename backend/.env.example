DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=public
# Tests use an isolated schema and never truncate the development schema.
TEST_DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=contract_test
# Defaults to shared ARC.rpcUrls[0] when omitted.
ARC_RPC_URL=https://rpc.testnet.arc.io
# Conservative provider-safe range; this is a correctness control, not a tuning target.
INDEXER_BLOCK_CHUNK=2000
INDEXER_POLL_MS=2000
# REST and WebSocket share this listener. WebSocket path: /ws.
API_HOST=0.0.0.0
API_PORT=3001
