DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=public
DATABASE_POOL_SIZE=32
DATABASE_POOL_TIMEOUT_SECONDS=10
# Tests use an isolated schema and never truncate the development schema.
TEST_DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=contract_test
# Benchmarks accept only a perf_bench or perf_bench_* schema.
BENCH_DATABASE_URL=postgresql://predex:predex@localhost:5432/predex_pump?schema=perf_bench
# Defaults to shared ARC.rpcUrls[0] when omitted.
ARC_RPC_URL=https://rpc.testnet.arc.network
# Conservative provider-safe range; this is a correctness control, not a tuning target.
INDEXER_BLOCK_CHUNK=2000
INDEXER_POLL_MS=10000
INDEXER_CHUNK_DELAY_MS=200
INDEXER_STALL_MS=90000
# REST and WebSocket share this listener. WebSocket path: /ws.
API_HOST=0.0.0.0
API_PORT=3001

# Same-fact dedup. Leave OPENAI_API_KEY empty to use the deterministic local provider.
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=
DEDUP_TOP_K=5
DEDUP_TIMEOUT_MS=5000
