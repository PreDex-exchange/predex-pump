// predex-pump backend — Postgres read model over the Arc incubator.
// Raw on-chain uints are exact decimal strings; timestamps are Unix seconds.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id                    String  @id // marketId (decimal string)
  creator               String
  question              String
  ancillaryData         String
  ancillaryDataHash     String
  metadataHash          String
  phase                 String  @default("Opened")
  conditionId           String  @unique
  questionId            String
  marketTypeVersion     Int
  collateralAddress     String?
  collateralDecimals    Int?
  yesTokenId            String? @unique
  noTokenId             String? @unique
  seedRaw               String  @default("0")
  yesPriceRaw           String  @default("500000")
  noPriceRaw            String  @default("500000")
  graduationActivityRaw String  @default("0")
  bookAddress           String?
  frozenYesPriceRaw     String?
  handoffSizeRaw        String?
  yesSeedOrderId        String?
  noSeedOrderId         String?
  tradeCount            Int     @default(0)
  volumeRaw             String  @default("0")

  // Immutable-per-market parameter snapshot.
  openingFeeRaw          String @default("0")
  seedFloorRaw           String @default("0")
  seedCapRaw             String @default("0")
  fCapRaw                String @default("0")
  graduationThresholdRaw String @default("0")
  graduationTollRaw      String @default("0")
  inventoryTargetRaw     String @default("0")
  protocolFeeBps         Int    @default(0)
  depthFeeBps            Int    @default(0)
  tradingWindowSeconds   Int    @default(0)
  minimumTimeOpenSeconds Int    @default(0)
  // Mutable off-chain matching policy; not an exchange-contract parameter.
  minimumTickSizeRaw     String @default("1000")

  // Latest TradeState inventory/funding snapshot.
  qYesRaw             String @default("0")
  qNoRaw              String @default("0")
  fundingCommittedRaw String @default("0")
  bCurrentWad         String @default("0")
  inventoryYesRaw     String @default("0")
  inventoryNoRaw      String @default("0")
  lastSplitAmountRaw  String @default("0")
  lastMergeAmountRaw  String @default("0")

  createdAt     Int
  tradingEndsAt Int      @default(0)
  graduatedAt   Int?
  resolvedAt    Int?
  closedOutAt   Int?
  indexedAt     DateTime @updatedAt

  trades        Trade[]
  pricePoints   PricePoint[]
  orders        Order[]
  signedOrders  SignedOrder[]
  fills         Fill[]
  positions     Position[]
  resolution    Resolution?
  closeout      Closeout?
  bookMigration BookMigration?

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([phase, createdAt(sort: Desc), id(sort: Desc)])
  @@index([creator, createdAt(sort: Desc), id(sort: Desc)])
  @@index([phase, creator, createdAt(sort: Desc), id(sort: Desc)])
  @@index([questionId])
}

model Trade {
  id                   String @id // `${txHash}:${logIndex}`
  marketId             String
  venue                String // LMSR | BOOK
  account              String
  recipient            String
  outcome              String // YES | NO
  side                 String // BID | ASK
  sizeRaw              String
  priceRaw             String
  costRaw              String
  feeRaw               String
  baseAmountRaw        String
  protocolFeeRaw       String
  depthContributionRaw String
  totalCostRaw         String
  netProceedsRaw       String
  txHash               String
  logIndex             Int
  blockNumber          Int
  ts                   Int
  market               Market @relation(fields: [marketId], references: [id])

  @@unique([txHash, logIndex])
  @@index([marketId, blockNumber(sort: Desc), logIndex(sort: Desc)])
  @@index([account, blockNumber(sort: Desc), logIndex(sort: Desc)])
}

model PricePoint {
  id          String @id // `${txHash}:${logIndex}`
  marketId    String
  yesPriceRaw String
  noPriceRaw  String
  qYesRaw     String
  qNoRaw      String
  bCurrentWad String
  txHash      String
  logIndex    Int
  blockNumber Int
  ts          Int
  market      Market @relation(fields: [marketId], references: [id])

  @@unique([txHash, logIndex])
  @@index([marketId, ts, blockNumber, logIndex])
}

model Order {
  orderId      String  @id // MiniCLOB uint256 order id
  marketId     String
  conditionId  String
  tokenId      String
  outcome      String // YES | NO
  maker        String
  side         String // BID | ASK
  priceRaw     String
  sizeRaw      String
  escrowRaw    String
  filledRaw    String  @default("0")
  remainingRaw String
  open         Boolean @default(true)
  isSeed       Boolean @default(false)
  txHash       String
  logIndex     Int
  blockNumber  Int
  createdAt    Int
  updatedAt    Int
  market       Market  @relation(fields: [marketId], references: [id])
  fills        Fill[]

  @@index([marketId, open])
  @@index([tokenId, open])
  @@index([maker])
}

model Fill {
  id             String  @id // `${txHash}:${logIndex}`
  orderId        String
  marketId       String
  taker          String
  maker          String
  outcome        String
  fillSizeRaw    String
  paymentRaw     String
  filledAfterRaw String
  openAfter      Boolean
  txHash         String
  logIndex       Int
  blockNumber    Int
  ts             Int
  order          Order   @relation(fields: [orderId], references: [orderId])
  market         Market  @relation(fields: [marketId], references: [id])

  @@unique([txHash, logIndex])
  @@index([marketId, ts])
  @@index([taker, ts])
}

// Full EIP-712 CTFExchange order plus operator-derived book fields. The digest
// is the natural identity; amounts remain exact decimal strings.
model SignedOrder {
  orderHash      String @id
  saltRaw        String
  maker          String
  signer         String
  taker          String
  tokenId        String
  makerAmountRaw String
  takerAmountRaw String
  expiration     Int
  nonceRaw       String
  feeRateBpsRaw  String
  exchangeSide   Int
  signatureType  Int
  signature      String

  marketId           String
  conditionId        String
  outcome            String
  side               String
  priceRaw           String
  sizeRaw            String
  filledRaw          String  @default("0")
  remainingRaw       String
  status             String  @default("OPEN")
  origin             String  @default("USER") // USER | BOOK_MIGRATION
  withdrawnAt        Int?
  lastFailureCode    String?
  lastFailureMessage String?
  lastFailureAt      Int?
  lastOnchainTxHash  String?
  lastOnchainBlock   Int?
  createdAt          Int
  updatedAt          Int

  market         Market            @relation(fields: [marketId], references: [id])
  matchesAsTaker SettlementMatch[] @relation("SettlementTakerOrder")
  matchesAsMaker SettlementMatch[] @relation("SettlementMakerOrder")

  @@index([marketId, status, withdrawnAt])
  @@index([tokenId, status, withdrawnAt])
  @@index([maker, status, withdrawnAt])
  @@index([expiration])
  @@index([origin, marketId])
}

// Durable, one-way handoff of a graduated market's two MiniCLOB seed orders.
// A row is never deleted after MIGRATED, so marketId is the once-only guard.
model BookMigration {
  marketId String @id
  status   String @default("DISCOVERED")

  yesSeedOrderId          String
  noSeedOrderId           String
  snapshotBlockNumber     Int?
  snapshotNonceRaw        String?
  yesPriceRaw             String?
  noPriceRaw              String?
  yesSnapshotRemainingRaw String?
  noSnapshotRemainingRaw  String?
  minimumTickSizeRaw       String?
  yesRealizedPriceRaw      String?
  noRealizedPriceRaw       String?
  yesPriceDeviationRaw     String?
  noPriceDeviationRaw      String?
  yesReplacementSizeRaw    String?
  noReplacementSizeRaw     String?
  yesUnquotedRemainderRaw  String?
  noUnquotedRemainderRaw   String?
  yesRecoveredRaw         String?
  noRecoveredRaw          String?
  yesReplacementOrderHash String?
  noReplacementOrderHash  String?

  approvalStatus      String  @default("UNCHECKED")
  approvalTxHash      String?
  approvalBlockNumber Int?
  yesCancelStatus     String  @default("UNCHECKED")
  noCancelStatus      String  @default("UNCHECKED")
  yesCancelTxHash     String?
  noCancelTxHash      String?
  activeCancelOutcome String?
  cancelBlockNumber   Int?
  recoveryBlockNumber Int?
  yesBalanceRaw       String?
  noBalanceRaw        String?

  attemptCount       Int     @default(0)
  nextAttemptAt      Int     @default(0)
  claimToken         String?
  claimExpiresAt     Int?
  lastFailureCode    String?
  lastFailureMessage String?
  lastFailureAt      Int?
  createdAt          Int
  updatedAt          Int
  cancelledAt        Int?
  migratedAt         Int?

  market Market @relation(fields: [marketId], references: [id])

  @@index([status, nextAttemptAt, createdAt])
  @@index([claimExpiresAt])
  @@index([yesReplacementOrderHash])
  @@index([noReplacementOrderHash])
}

model ExchangeTokenRegistration {
  tokenId           String @id
  complementTokenId String
  conditionId       String
  blockNumber       Int
  logIndex          Int
  registeredAt      Int

  @@index([conditionId])
}

// Only ApprovalForAll events naming CTFExchange are materialized here.
model CtfExchangeApproval {
  owner       String  @id
  approved    Boolean
  blockNumber Int
  logIndex    Int
  updatedAt   Int
}

// Only ERC-20 Approval events naming CTFExchange are materialized here.
model CollateralExchangeApproval {
  owner        String @id
  allowanceRaw String
  blockNumber  Int
  logIndex     Int
  updatedAt    Int
}

// BUY-order maker balances are snapshotted at ingest and advanced by
// topic-filtered collateral Transfer events for tracked makers.
model CollateralBalance {
  owner       String @id
  balanceRaw  String
  blockNumber Int
  logIndex    Int
  updatedAt   Int
}

model SettlementMatch {
  id                   String  @id
  matchKey             String  @unique
  takerOrderHash       String
  makerOrderHash       String
  tokenId              String
  fillSizeRaw          String
  takerFilledBeforeRaw String
  makerFilledBeforeRaw String
  status               String
  attemptCount         Int     @default(0)
  txHash               String?
  failureCode          String?
  failureMessage       String?
  createdAt            Int
  updatedAt            Int

  takerOrder SignedOrder @relation("SettlementTakerOrder", fields: [takerOrderHash], references: [orderHash])
  makerOrder SignedOrder @relation("SettlementMakerOrder", fields: [makerOrderHash], references: [orderHash])

  @@index([status, createdAt])
  @@index([txHash])
  @@index([takerOrderHash])
  @@index([makerOrderHash])
}

model Position {
  account            String
  marketId           String
  outcome            String // YES | NO
  qtyRaw             String  @default("0")
  costBasisRaw       String  @default("0")
  costBasisEstimated Boolean @default(true)
  realizedPnlRaw     String  @default("0")
  unrealizedPnlRaw   String  @default("0")
  updatedAt          Int
  market             Market  @relation(fields: [marketId], references: [id])

  @@id([account, marketId, outcome])
  @@index([account, updatedAt(sort: Desc), marketId(sort: Desc), outcome])
  @@index([marketId, outcome, account])
}

model Resolution {
  marketId    String @id
  conditionId String
  outcome     String // YES | NO | INVALID
  payoutYes   Int
  payoutNo    Int
  denominator Int
  resolvedAt  Int
  observedAt  Int?
  txHash      String
  logIndex    Int
  market      Market @relation(fields: [marketId], references: [id])
}

model Closeout {
  marketId                 String @id
  conditionId              String
  payoutYes                String
  payoutNo                 String
  userTerminalClaimRaw     String
  netBaseTradeCollectedRaw String
  fundingLossRaw           String
  fundingResidualRaw       String
  protocolPnlRaw           String
  protocolFeesRaw          String
  redeemedYesRaw           String
  redeemedNoRaw            String
  closedOutAt              Int
  txHash                   String
  logIndex                 Int
  market                   Market @relation(fields: [marketId], references: [id])
}

model Account {
  address          String @id
  firstSeenAt      Int
  marketsCreated   Int    @default(0)
  tradeCount       Int    @default(0)
  realizedPnlRaw   String @default("0")
  unrealizedPnlRaw String @default("0")
}

// Additive, off-chain account data. The indexer-owned Account model above
// remains the source for every chain-derived field.
model UserAccount {
  address                String                 @id
  displayName            String?
  rememberRecentlyViewed Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  sessions               AuthSession[]
  watchlist              AccountWatchlist[]
  behavior               AccountBehaviorEvent[]
}

model SiweNonce {
  nonce      String    @id
  domain     String
  uri        String
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([expiresAt])
}

model AuthSession {
  tokenHash      String      @id
  accountAddress String
  createdAt      DateTime    @default(now())
  expiresAt      DateTime
  account        UserAccount @relation(fields: [accountAddress], references: [address], onDelete: Cascade)

  @@index([accountAddress, expiresAt])
  @@index([expiresAt])
}

model AccountWatchlist {
  accountAddress String
  marketId       String
  addedAt        DateTime    @default(now())
  account        UserAccount @relation(fields: [accountAddress], references: [address], onDelete: Cascade)

  @@id([accountAddress, marketId])
  @@index([marketId])
}

model AccountBehaviorEvent {
  id             String      @id @default(cuid())
  accountAddress String
  type           String
  marketId       String
  occurredAt     DateTime    @default(now())
  account        UserAccount @relation(fields: [accountAddress], references: [address], onDelete: Cascade)

  // Retain only the latest view/decision for a market and behavior type.
  @@unique([accountAddress, type, marketId])
  @@index([accountAddress, occurredAt(sort: Desc)])
}

// One row for every decoded contract event. This is also the atomic per-log
// idempotency guard for all derived writes.
model ActivityEvent {
  id          String  @id // `${txHash}:${logIndex}`
  type        String
  eventName   String
  source      String
  marketId    String?
  account     String?
  outcome     String?
  side        String?
  amountRaw   String?
  priceRaw    String?
  txHash      String
  logIndex    Int
  blockNumber Int
  ts          Int
  data        Json

  @@unique([txHash, logIndex])
  @@index([blockNumber(sort: Desc), logIndex(sort: Desc)])
  @@index([marketId, blockNumber(sort: Desc), logIndex(sort: Desc)])
  @@index([account, blockNumber(sort: Desc), logIndex(sort: Desc)])
  @@index([marketId, account, blockNumber(sort: Desc), logIndex(sort: Desc)])
}

model RegistryConfig {
  id                            Int      @id @default(1)
  chainId                       Int
  usdcAddress                   String
  ctfAddress                    String
  oracleAddress                 String
  lmsrAddress                   String
  registryAddress               String
  miniClobAddress               String
  marketTypeVersion             Int      @default(0)
  currentLmsrAddress            String
  openingFeeRaw                 String   @default("0")
  seedFloorRaw                  String   @default("0")
  seedCapRaw                    String   @default("0")
  fCapRaw                       String   @default("0")
  singleTopUpCapRaw             String   @default("0")
  graduationMoneyInThresholdRaw String   @default("0")
  graduationTollRaw             String   @default("0")
  inventoryTargetRaw            String   @default("0")
  inventoryLowRaw               String   @default("0")
  inventoryHighRaw              String   @default("0")
  freeCollateralBufferRaw       String   @default("0")
  defaultTradingWindowSeconds   Int      @default(0)
  minTradingWindowSeconds       Int      @default(0)
  maxTradingWindowSeconds       Int      @default(0)
  minimumTimeOpenSeconds        Int      @default(0)
  protocolFeeBps                Int      @default(0)
  depthFeeBps                   Int      @default(0)
  committeeThreshold            Int      @default(0)
  updatedBlock                  Int
  updatedAt                     DateTime @updatedAt
}

model RegisteredMarketType {
  version      Int    @id
  lmsrAddress  String
  configHash   String
  registeredAt Int
  blockNumber  Int
}

model CommitteeMember {
  address      String  @id
  active       Boolean
  addedAt      Int
  removedAt    Int?
  updatedBlock Int

  @@index([active])
}

// Singleton replay cursor and chain-lag state.
model IndexerState {
  id                     Int       @id @default(1)
  chainId                Int
  deployBlock            Int
  lastBlock              Int
  headBlock              Int       @default(0)
  lastSuccessfulPollAt   DateTime?
  consecutiveRpcFailures Int       @default(0)
  updatedAt              DateTime  @updatedAt
}

// Kept separate from IndexerState so high-frequency subscription liveness
// never contends with the serializable cursor/event transaction.
model IndexerSubscriptionState {
  id            Int       @id @default(1)
  status        String    @default("polling")
  headBlock     Int       @default(0)
  lastMessageAt DateTime?
  updatedAt     DateTime  @updatedAt
}
