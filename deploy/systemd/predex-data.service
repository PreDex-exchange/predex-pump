[Unit]
Description=Predex continuity data services
PartOf=predex.target
Before=predex-api.service predex-indexer.service predex-operator.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/users/span14/predex-builds/predex-pump/runtime/runtime.env
ExecStartPre=/users/span14/predex-builds/predex-pump/runtime/bin/runtime-remote.sh unit-preflight data
ExecStart=/users/span14/predex-builds/predex-pump/runtime/bin/runtime-remote.sh data-up
ExecStartPost=/users/span14/predex-builds/predex-pump/runtime/bin/runtime-remote.sh migrate-database
ExecStop=/users/span14/predex-builds/predex-pump/runtime/bin/runtime-remote.sh data-stop
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStartSec=180
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=predex-data
UMask=0077

[Install]
WantedBy=predex.target
