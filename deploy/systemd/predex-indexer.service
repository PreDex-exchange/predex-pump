[Unit]
Description=Predex singleton Arc indexer
PartOf=predex.target
Requires=predex-data.service
After=predex-data.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/users/span14/predex-builds/predex-pump/runtime/runtime.env
Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql://predex:predex@127.0.0.1:5432/predex_pump?schema=public
Environment=DATABASE_POOL_SIZE=8
Environment=REDIS_URL=redis://127.0.0.1:6379
Environment=REDIS_KEY_PREFIX=predex-continuity-deadline
Environment=QDRANT_URL=http://127.0.0.1:6333
Environment=INDEXER_START_POLICY=resume
Environment=PATH=/users/span14/.local/predex-toolchain/node-v22.19.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/users/span14/predex-builds/predex-pump/source/backend
ExecStartPre=/users/span14/predex-builds/predex-pump/runtime/bin/runtime-remote.sh unit-preflight indexer
ExecStart=/users/span14/.local/predex-toolchain/node-v22.19.0-linux-x64/bin/pnpm indexer
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStopSec=130
StandardOutput=journal
StandardError=journal
SyslogIdentifier=predex-indexer
UMask=0077

[Install]
WantedBy=predex.target
